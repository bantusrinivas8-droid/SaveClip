// Cloudflare Worker for SaveClip (free plan).
// - Serves the website from ./static at https://saveclip.<you>.workers.dev
// - Forwards /api/* to SaveClip running on your own computer through a free Cloudflare Tunnel.
{
  "name": "saveclip",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Remembers the current tunnel address of your computer (free SQLite Durable Object).
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "Backend" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Backend"] }]
}
